{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sidequesttravel.app",
        "EXPO_PUBLIC_WEB_URL": "https://sidequesttravel.app"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sidequesttravel.app",
        "EXPO_PUBLIC_WEB_URL": "https://sidequesttravel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sidequesttravel.app",
        "EXPO_PUBLIC_WEB_URL": "https://sidequesttravel.app",
        "EXPO_PUBLIC_DISABLE_DEV_AUTO_LOGIN": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6770268183",
        "appleTeamId": "6G8MYZYVL5"
      }
    }
  }
}
