{
  "expo": {
    "name": "SideQuest",
    "slug": "sidequestmobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sidequest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "requiresFullScreen": true,
      "bundleIdentifier": "app.sidequesttravel.mobile",
      "buildNumber": "2",
      "associatedDomains": [
        "applinks:sidequesttravel.app",
        "applinks:www.sidequesttravel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "spotify"
        ],
        "NSCameraUsageDescription": "SideQuest uses your camera to take photos for your profile picture, trip and activity covers, and expense receipts.",
        "NSPhotoLibraryUsageDescription": "SideQuest accesses your photo library so you can choose photos for your profile picture, trip and activity covers, and expense receipts."
      }
    },
    "android": {
      "package": "app.sidequesttravel.mobile",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "sidequesttravel.app", "pathPrefix": "/invite" },
            { "scheme": "https", "host": "sidequesttravel.app", "pathPrefix": "/share" },
            { "scheme": "https", "host": "sidequesttravel.app", "pathPrefix": "/auth-callback" },
            { "scheme": "https", "host": "sidequesttravel.app", "pathPrefix": "/reset-password" },
            { "scheme": "https", "host": "www.sidequesttravel.app", "pathPrefix": "/invite" },
            { "scheme": "https", "host": "www.sidequesttravel.app", "pathPrefix": "/share" },
            { "scheme": "https", "host": "www.sidequesttravel.app", "pathPrefix": "/auth-callback" },
            { "scheme": "https", "host": "www.sidequesttravel.app", "pathPrefix": "/reset-password" }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff7f8"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "SideQuest accesses your photo library so you can choose photos for your profile picture, trip and activity covers, and expense receipts.",
          "cameraPermission": "SideQuest uses your camera to take photos for your profile picture, trip and activity covers, and expense receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ddeded0-671f-4051-b28a-bd745342de87"
      }
    },
    "owner": "vangopo"
  }
}
